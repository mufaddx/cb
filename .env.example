# =============================================================
# Antigravity Platform — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# =============================================================

# ---- App ----
# Production target: app.vidlix.in (this platform's product name is
# Vidlix — "Antigravity" below is only the internal build codename).
# Point APP_URL/API_URL at that domain (e.g. https://app.vidlix.in and
# https://api.vidlix.in) once deployed; CORS in apps/api/src/app.ts
# trusts APP_URL exactly, so it must match what the browser is on.
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ---- Database (MySQL) ----
DATABASE_URL="mysql://antigravity:antigravity@localhost:3306/antigravity"
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=antigravity
MYSQL_USER=antigravity
MYSQL_PASSWORD=antigravity
MYSQL_ROOT_PASSWORD=change-me-root

# ---- Redis (cache / job queue) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
SESSION_SECRET=replace-with-64-char-random-hex
JWT_SECRET=replace-with-64-char-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Email (Resend) ----
# EMAIL_PROVIDER=console enables a dev-only adapter that logs emails
# instead of sending them. Set to "resend" once RESEND_API_KEY is set.
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL="Vidlix <notifications@app.vidlix.in>"

# ---- Object storage (Cloudflare R2) ----
# STORAGE_PROVIDER=local enables a dev-only adapter that writes to
# ./storage/local instead of R2. Set to "r2" once credentials are set.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=antigravity
R2_SIGNED_URL_TTL_SECONDS=900

# ---- Instagram / Meta ----
# INSTAGRAM_PROVIDER=mock enables a dev-only adapter with fixture data.
# Set to "meta" once a Meta Developer App is configured.
INSTAGRAM_PROVIDER=mock
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/creator/instagram/callback

# ---- Payments ----
# PAYMENT_PROVIDER=mock enables a dev-only adapter that simulates
# payment intents/webhooks without calling a real provider.
# Set to "razorpay" once a Razorpay account is live.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---- Rate limiting / security ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Background jobs ----
# In-process interval scheduler (apps/api/src/jobs/scheduler.ts) —
# single-instance only. Scale to multiple API instances requires
# replacing this with a real queue against REDIS_URL first.
ENABLE_BACKGROUND_JOBS=true
RETENTION_JOB_INTERVAL_MINUTES=60
OFFER_EXPIRY_JOB_INTERVAL_MINUTES=15
